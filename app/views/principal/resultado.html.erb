<h1 class="text-center display-4 my-5 font-weight-bold">Resultado da Avaliação</h1>

<div class="container">
  <div class="row g-4">

    <!-- Resultado Olho Esquerdo -->
    <div class="col-md-6">
      <div class="card shadow-lg">
        <div class="card-header text-center bg-primary text-white">
          <h2>Olho Esquerdo</h2>
        </div>
        <div class="card-body">
          <p class="mb-3">
            <strong>Entrada:</strong>
            <%= @olho_esquerdo.presence ||
                (@pl_esquerdo ? "PL" :
                @npl_esquerdo ? "NPL" :
                @conta_dedos_esquerdo ? "Conta dedos" :
                @vultos_esquerdo ? "Vultos / movimento de mãos" :
                @indeterminado_esquerdo ? "Indeterminado" : "-") %>
          </p>
          <p class="mb-3"><strong>Categoria:</strong> <%= @categoria_esquerdo %></p>
          <p class="mb-0"><strong>CID:</strong> <%= @cid_esquerdo %></p>
        </div>
      </div>
    </div>

    <!-- Resultado Olho Direito -->
    <div class="col-md-6">
      <div class="card shadow-lg">
        <div class="card-header text-center bg-primary text-white">
          <h2>Olho Direito</h2>
        </div>
        <div class="card-body">
          <p class="mb-3">
            <strong>Entrada:</strong>
            <%= @olho_direito.presence ||
                (@pl_direito ? "PL" :
                @npl_direito ? "NPL" :
                @conta_dedos_direito ? "Conta dedos" :
                @vultos_direito ? "Vultos / movimento de mãos" :
                @indeterminado_direito ? "Indeterminado" : "-") %>
          </p>
          <p class="mb-3"><strong>Categoria:</strong> <%= @categoria_direito %></p>
          <p class="mb-0"><strong>CID:</strong> <%= @cid_direito %></p>
        </div>
      </div>
    </div>

  </div>

  <!-- Diagnóstico Final -->
  <div class="card shadow-lg text-center mt-5">
    <div class="card-body bg-light">
      <p class="h5 font-weight-bold"><strong>Diagnóstico Final:</strong> <%= @descricao_cid %></p>
    </div>
  </div>

  <!-- Botão Voltar -->
  <div class="text-center mt-4">
    <%= link_to "Voltar", root_path, class: "btn btn-primary btn-lg px-5 py-2" %>
  </div>
</div>
